{
  "name": "sendora",
  "version": "0.1.0",
  "private": true,
  "description": "Cold email outreach for job seekers — recruiter outreach feature",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "theme:build": "astryx theme build lib/theme/neutralTheme.ts",
