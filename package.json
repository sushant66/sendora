    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "next-auth": "5.0.0-beta.31",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.6",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
