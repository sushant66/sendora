# Copy to .env.local and fill in. NEVER commit real secrets.

# NeonDB (serverless Postgres) connection string
DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/sendora?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console → Credentials → OAuth 2.0 Client, Web app)
# Enable the Gmail API and authorize the scope: https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Key used to encrypt stored Gmail refresh tokens at rest — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Base URL for OAuth callbacks
APP_URL="http://localhost:3000"

# Cloud Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""